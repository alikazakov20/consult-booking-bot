generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// active -> ссылкой ещё можно воспользоваться, used -> по ней уже создана запись
model AccessLink {
  id        Int       @id @default(autoincrement())
  token     String    @unique
  status    String    @default("active")
  createdAt DateTime  @default(now())
  usedAt    DateTime?
}

// Запись на консультацию. Длительность всегда фиксированная (см. server/src/schedule.ts),
// поэтому endMin хранится просто для удобства отображения, а не для гибкой длительности.
model Booking {
  id           Int      @id @default(autoincrement())
  telegramId   BigInt
  telegramName String?
  date         DateTime
  startMin     Int
  endMin       Int
  createdAt    DateTime @default(now())

  @@unique([date, startMin])
}
