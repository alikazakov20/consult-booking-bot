# Токен бота от @BotFather
BOT_TOKEN=123456:AAExampleTokenReplaceMe

# Ваш личный Telegram numeric ID (узнать у @userinfobot) — только этот пользователь получает доступ к админке
ADMIN_TELEGRAM_ID=123456789

# Публичный HTTPS-адрес, на котором развёрнуто приложение (без завершающего /).
# Telegram Mini App обязательно требует HTTPS. Локально для теста можно прокинуть через ngrok/cloudflared.
WEBAPP_URL=https://your-domain.example.com

# polling — бот сам опрашивает Telegram (проще для локальной разработки)
# webhook — Telegram сам стучится на WEBAPP_URL/telegram/webhook/<WEBHOOK_SECRET> (рекомендуется в проде)
BOT_MODE=polling
WEBHOOK_SECRET=change-me-to-a-random-string

PORT=3000
DATABASE_URL="file:./dev.db"

# За сколько часов до консультации слать напоминание клиенту
REMINDER_HOURS_BEFORE=3
